{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyEc2InApprovedRegion",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcs",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ResolveOfficialAmazonLinuxAmi",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1::parameter/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    {
      "Sid": "ListDeploymentStatePrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${state_bucket}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "deployments/*"
          ]
        }
      }
    },
    {
      "Sid": "DeploymentStateRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${state_bucket}/deployments/*/terraform.tfstate"
    },
    {
      "Sid": "DeploymentStateLockFiles",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::${state_bucket}/deployments/*/terraform.tfstate.tflock"
    },
    {
      "Sid": "NeverTouchBootstrapState",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::${state_bucket}/bootstrap/*"
    },
    {
      "Sid": "PlanningNeverWritesOrDeletesState",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::${state_bucket}/deployments/*/terraform.tfstate"
    }
  ]
}
